# Domain (or public IP, for local testing) where this app will be reachable.
# Used to build embed links and Caddy's automatic HTTPS cert.
PUBLIC_HOST=stream.example.com

# Optional: only set this if PUBLIC_HOST is proxied through a CDN (e.g.
# Cloudflare) that doesn't forward the RTMP port. Set it to your server's
# raw IP (or an unproxied hostname) so the dashboard shows a working RTMP
# URL. Leave unset to just reuse PUBLIC_HOST.
# RTMP_PUBLIC_HOST=203.0.113.10

# Optional: enables the "Send to YouTube" relay feature. From a Google Cloud
# project with the YouTube Data API v3 enabled and OAuth credentials created
# (see README). Leave unset to skip YouTube integration entirely.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=https://stream.example.com/api/youtube/callback

# Optional: restricts which sites may embed your player / hotlink the video
# feed, instead of the default of allowing embedding anywhere. Comma-separated
# hostnames, no protocol. Leave unset to keep the open-by-default behavior.
# ALLOWED_EMBED_DOMAINS=example.com,www.example.com

# Optional: enables Country/Region/City columns on the dashboard's Stats
# page. Free to get - sign up at https://www.maxmind.com/en/geolite2/signup,
# then create a license key under your account's "My License Key" page (see
# README). Leave unset to skip geolocation - Stats still works, those three
# columns are just blank.
# GEOIP_LICENSE_KEY=your-maxmind-license-key

# Optional: enables per-channel stream recording, uploaded to a private
# Cloudflare R2 bucket (admin-only playback/download - never public). From a
# Cloudflare account with R2 enabled and an API token created (see README).
# Leave any of these unset to skip recording entirely - the toggle on the
# dashboard just won't do anything without all four.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=your-bucket-name

# Optional: automatically deletes recordings older than this many days.
# Leave unset (or 0) to keep every recording until you delete it yourself
# from the dashboard.
# RECORDING_RETENTION_DAYS=90

# Optional: once a single recording has been running this many hours, the
# channel detail page shows a "still recording - keep going?" prompt
# instead of just cutting it off - protects against an accidentally-left-
# running stream filling up the server's disk, while still allowing a
# genuinely long event to continue with an admin's OK. Defaults to 4 if unset.
# RECORDING_WARN_HOURS=4

# Optional: if nobody answers that prompt within this many minutes,
# recording stops automatically (whatever was captured still gets uploaded/
# cleaned up normally) - matches the original "forgot to stop it" case this
# is meant to catch. Defaults to 15 if unset.
# RECORDING_GRACE_MINUTES=15

# Optional: how long (in milliseconds) to wait after an encoder connects
# before marking the channel live to anyone (dashboard included). A brand
# new RTMP connection is accepted well before nginx has an actual usable HLS
# segment ready - especially with a CDN in front - so this exists to avoid a
# window where the play button is visible but silently doesn't work yet.
# Defaults to 15000 (15s) if unset.
# LIVE_DELAY_MS=15000

# Admin dashboard login (this is the only account - single admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random secrets - generate each with: openssl rand -hex 32
SESSION_SECRET=change-me
WEBHOOK_SECRET=change-me

# Optional: a second, fully isolated copy of the app (its own admin login,
# RTMP port, and data - nothing shared with production) served at
# dev.stream.rossmackenzie.co.uk on this same droplet, for testing changes
# before they go live. Only takes effect once you run
# `docker compose up -d --build dev-rtmp dev-backend caddy`. Leave commented
# out if you don't want the dev stack running at all.
# DEV_PUBLIC_HOST=dev.stream.rossmackenzie.co.uk
# DEV_ADMIN_USERNAME=admin
# DEV_ADMIN_PASSWORD=change-me-to-a-different-strong-password
# DEV_SESSION_SECRET=change-me
# DEV_WEBHOOK_SECRET=change-me
# DEV_GOOGLE_REDIRECT_URI=https://dev.stream.rossmackenzie.co.uk/api/youtube/callback
# DEV_ALLOWED_EMBED_DOMAINS=
# DEV_R2_ACCOUNT_ID=
# DEV_R2_ACCESS_KEY_ID=
# DEV_R2_SECRET_ACCESS_KEY=
# DEV_R2_BUCKET_NAME=
