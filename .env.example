# Domain (or public IP, for local testing) where this app will be reachable.
# Used to build embed links and Caddy's automatic HTTPS cert.
PUBLIC_HOST=stream.example.com

# Optional: only set this if PUBLIC_HOST is proxied through a CDN (e.g.
# Cloudflare) that doesn't forward the RTMP port. Set it to your server's
# raw IP (or an unproxied hostname) so the dashboard shows a working RTMP
# URL. Leave unset to just reuse PUBLIC_HOST.
# RTMP_PUBLIC_HOST=203.0.113.10

# YouTube relaying ("Send to YouTube") is dev-site-only by design - these
# only ever take effect when IS_DEV_SITE=true, which only the separate dev
# deployment sets (see README's "Dev/staging deployment"). Setting them here,
# on production, does nothing: the app won't mount the YouTube routes or
# show any YouTube UI regardless - configure them in the dev folder's own
# .env instead.

# Optional: enables the Stats page's "Import from Restream" button, which
# pulls YouTube/Facebook view counts (for streams relayed through Restream
# as native destinations, not this app's own Custom RTMP destination - see
# README) into the stats table. From an app registered at
# developers.restream.io (see README's "Importing Restream stats"). Leave
# unset to skip this entirely - the rest of the Stats page works regardless.
# RESTREAM_CLIENT_ID=your-restream-client-id
# RESTREAM_CLIENT_SECRET=your-restream-client-secret
# RESTREAM_REDIRECT_URI=https://stream.example.com/api/restream/callback

# Optional: lets an external scheduler (e.g. cron-job.org) run that same
# Restream import on a schedule - see README's "Automatic weekly import".
# Generate with: openssl rand -hex 32. Leave unset to keep imports manual-only.
# RESTREAM_IMPORT_SECRET=

# Optional: restricts which sites may embed your player / hotlink the video
# feed, instead of the default of allowing embedding anywhere. Comma-separated
# hostnames, no protocol. Leave unset to keep the open-by-default behavior.
# ALLOWED_EMBED_DOMAINS=example.com,www.example.com

# Optional: enables Country/Region/City columns on the dashboard's Stats
# page. Free to get - sign up at https://www.maxmind.com/en/geolite2/signup,
# then create a license key under your account's "My License Key" page (see
# README). Leave unset to skip geolocation - Stats still works, those three
# columns are just blank.
# GEOIP_LICENSE_KEY=your-maxmind-license-key

# Optional: enables per-channel stream recording, uploaded to a private
# Cloudflare R2 bucket (admin-only playback/download - never public). From a
# Cloudflare account with R2 enabled and an API token created (see README).
# Leave any of these unset to skip recording entirely - the "Record streams"
# toggle and the Recordings page will show a "Recording is disabled in the
# app config" popup instead of doing anything.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=your-bucket-name

# Optional: turns recording off everywhere even if R2 above is fully
# configured - the same "disabled" popup shows either way. Leave unset
# (defaults to enabled, as long as R2 is configured) unless you specifically
# want to disable recording without removing your R2 credentials.
# RECORDINGS_ENABLED=false

# Optional: automatically deletes recordings older than this many days.
# Leave unset (or 0) to keep every recording until you delete it yourself
# from the dashboard.
# RECORDING_RETENTION_DAYS=90

# Optional: once a single recording has been running this many hours, the
# channel detail page shows a "still recording - keep going?" prompt
# instead of just cutting it off - protects against an accidentally-left-
# running stream filling up the server's disk, while still allowing a
# genuinely long event to continue with an admin's OK. Defaults to 4 if unset.
# RECORDING_WARN_HOURS=4

# Optional: if nobody answers that prompt within this many minutes,
# recording stops automatically (whatever was captured still gets uploaded/
# cleaned up normally) - matches the original "forgot to stop it" case this
# is meant to catch. Defaults to 15 if unset.
# RECORDING_GRACE_MINUTES=15

# Optional: how long (in milliseconds) to wait after an encoder connects
# before marking the channel live to anyone (dashboard included). A brand
# new RTMP connection is accepted well before nginx has an actual usable HLS
# segment ready - especially with a CDN in front - so this exists to avoid a
# window where the play button is visible but silently doesn't work yet.
# Defaults to 15000 (15s) if unset.
# LIVE_DELAY_MS=15000

# Admin dashboard login - via Auth0 rather than a local password (see
# README's "Setting up Auth0 login" for how to create these). Auth0 only
# confirms WHO logged in; ADMIN_EMAIL is what actually decides whether
# they're let into the dashboard.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_CALLBACK_URL=https://stream.example.com/auth/callback
ADMIN_EMAIL=you@example.com

# Random secrets - generate each with: openssl rand -hex 32
SESSION_SECRET=change-me
WEBHOOK_SECRET=change-me

# A second, fully isolated deployment (its own folder, its own checkout of
# the `dev` branch, its own .env, its own data) is served at
# dev.stream.rossmackenzie.co.uk for testing changes before they go live -
# see README's "Dev/staging deployment" for how to set it up. Nothing here
# configures it; it's a separate app entirely.
