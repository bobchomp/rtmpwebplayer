# This is the dev/staging deployment's own .env - a separate file from
# production's, in a separate folder, on the `dev` branch. See the main
# README's "Dev/staging deployment" section for the full setup. None of
# these variables are DEV_-prefixed - they don't need to be, since there's
# no production copy in this same file to collide with.

# Domain where this deployment is reachable. Used to build embed links and
# Caddy's automatic HTTPS cert for it (see the production folder's Caddyfile
# - this deployment shares production's one Caddy instance over a Docker
# network, rather than running a second one).
PUBLIC_HOST=dev.stream.example.com

# Optional: only set this if PUBLIC_HOST is proxied through a CDN (e.g.
# Cloudflare) that doesn't forward the RTMP port. Set it to your server's
# raw IP (or an unproxied hostname) so the dashboard shows a working RTMP
# URL. Leave unset to just reuse PUBLIC_HOST.
# RTMP_PUBLIC_HOST=203.0.113.10

# Enables the "Send to YouTube" relay feature - dev-site-only by design
# (see README's "Relaying to YouTube"), so this is the only place these
# ever take effect at all. From a Google Cloud project with the YouTube
# Data API v3 enabled and OAuth credentials created (see README's "One-time
# Google Cloud setup"). Leave unset to skip YouTube integration entirely.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=https://dev.stream.example.com/api/youtube/callback

# Optional: enables the Stats page's "Import from Restream" button. Reuses
# the same RESTREAM_CLIENT_ID/SECRET as production (same Restream app) -
# just add this domain's own callback URL to that app's allowed redirect
# URIs too, since the domain differs. Leave unset to skip this entirely.
# RESTREAM_CLIENT_ID=your-restream-client-id
# RESTREAM_CLIENT_SECRET=your-restream-client-secret
# RESTREAM_REDIRECT_URI=https://dev.stream.example.com/api/restream/callback

# Optional: restricts which sites may embed your player / hotlink the video
# feed, instead of the default of allowing embedding anywhere. Comma-separated
# hostnames, no protocol. Leave unset to keep the open-by-default behavior.
# ALLOWED_EMBED_DOMAINS=example.com,www.example.com

# Optional: enables Country/Region/City columns on the dashboard's Stats
# page. Free to get - see README's "Setting up GeoIP". Leave unset to skip
# geolocation - Stats still works, those three columns are just blank.
# GEOIP_LICENSE_KEY=your-maxmind-license-key

# Optional: enables per-channel stream recording, uploaded to a private
# Cloudflare R2 bucket - see README's "Setting up recording". Leave any of
# these unset to skip recording entirely.
# R2_ACCOUNT_ID=your-cloudflare-account-id
# R2_ACCESS_KEY_ID=your-r2-access-key-id
# R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
# R2_BUCKET_NAME=your-bucket-name

# Optional: turns recording off everywhere even if R2 above is fully
# configured. Leave unset (defaults to enabled, as long as R2 is configured).
# RECORDINGS_ENABLED=false

# Optional: automatically deletes recordings older than this many days.
# Leave unset (or 0) to keep every recording until you delete it yourself.
# RECORDING_RETENTION_DAYS=90

# Optional: once a single recording has been running this many hours, the
# channel detail page shows a "still recording - keep going?" prompt
# instead of just cutting it off. Defaults to 4 if unset.
# RECORDING_WARN_HOURS=4

# Optional: if nobody answers that prompt within this many minutes,
# recording stops automatically. Defaults to 15 if unset.
# RECORDING_GRACE_MINUTES=15

# Optional: how long (in milliseconds) to wait after an encoder connects
# before marking the channel live to anyone. Defaults to 15000 (15s) if unset.
# LIVE_DELAY_MS=15000

# Admin dashboard login - via Auth0. Reuses the same Auth0
# application/tenant as production (same person logs into both) - just add
# this domain's own callback URL to that application's Allowed Callback
# URLs list in the Auth0 dashboard, since the domain differs. ADMIN_EMAIL
# can be the same as production's, or different if you want a separate
# admin account for testing.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_CALLBACK_URL=https://dev.stream.example.com/auth/callback
ADMIN_EMAIL=you@example.com

# Random secrets, own values - don't reuse production's. Generate each with:
# openssl rand -hex 32
SESSION_SECRET=change-me
WEBHOOK_SECRET=change-me
