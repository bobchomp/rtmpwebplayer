# Domain (or public IP, for local testing) where this app will be reachable.
# Used to build embed links and Caddy's automatic HTTPS cert.
PUBLIC_HOST=stream.example.com

# Optional: only set this if PUBLIC_HOST is proxied through a CDN (e.g.
# Cloudflare) that doesn't forward the RTMP port. Set it to your server's
# raw IP (or an unproxied hostname) so the dashboard shows a working RTMP
# URL. Leave unset to just reuse PUBLIC_HOST.
# RTMP_PUBLIC_HOST=203.0.113.10

# Optional: enables the "Send to YouTube" relay feature. From a Google Cloud
# project with the YouTube Data API v3 enabled and OAuth credentials created
# (see README). Leave unset to skip YouTube integration entirely.
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=https://stream.example.com/api/youtube/callback

# Optional: restricts which sites may embed your player / hotlink the video
# feed, instead of the default of allowing embedding anywhere. Comma-separated
# hostnames, no protocol. Leave unset to keep the open-by-default behavior.
# ALLOWED_EMBED_DOMAINS=example.com,www.example.com

# Optional: enables Country/Region/City columns on the dashboard's Stats
# page. Free to get - sign up at https://www.maxmind.com/en/geolite2/signup,
# then create a license key under your account's "My License Key" page (see
# README). Leave unset to skip geolocation - Stats still works, those three
# columns are just blank.
# GEOIP_LICENSE_KEY=your-maxmind-license-key

# Optional: how long (in milliseconds) to wait after an encoder connects
# before marking the channel live to anyone (dashboard included). A brand
# new RTMP connection is accepted well before nginx has an actual usable HLS
# segment ready - especially with a CDN in front - so this exists to avoid a
# window where the play button is visible but silently doesn't work yet.
# Defaults to 15000 (15s) if unset.
# LIVE_DELAY_MS=15000

# Admin dashboard login (this is the only account - single admin).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password

# Random secrets - generate each with: openssl rand -hex 32
SESSION_SECRET=change-me
WEBHOOK_SECRET=change-me
