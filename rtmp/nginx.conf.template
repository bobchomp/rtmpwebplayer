worker_processes auto;
error_log /dev/stderr warn;
pid /tmp/nginx.pid;

events {
    worker_connections 1024;
}

rtmp {
    server {
        listen 1935;
        chunk_size 4096;

        application live {
            live on;
            record off;

            # Only this container may play RTMP directly; public playback goes
            # through HLS via the backend proxy, never raw RTMP.
            allow play 127.0.0.1;
            deny play all;

            # Backend validates the stream key and tracks live/offline state.
            # WEBHOOK_SECRET keeps these callbacks from being spoofed.
            on_publish http://backend:4000/api/rtmp/on_publish?secret=${WEBHOOK_SECRET};
            on_publish_done http://backend:4000/api/rtmp/on_publish_done?secret=${WEBHOOK_SECRET};

            hls on;
            hls_path /tmp/hls;
            hls_nested on;
            hls_fragment 3s;
            hls_playlist_length 30s;
            hls_cleanup on;
            hls_continuous on;
        }
    }
}

http {
    include mime.types;
    default_type application/octet-stream;
    sendfile off;
    access_log off;

    server {
        listen 8080;
        server_name _;

        # Internal only (not published to the host) - the backend proxies
        # requests here using the secret stream key, viewers never see it.
        location /hls {
            types {
                application/vnd.apple.mpegurl m3u8;
                video/mp2t ts;
            }
            alias /tmp/hls/;
            add_header Cache-Control no-cache;
        }
    }
}
